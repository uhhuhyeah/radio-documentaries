.DS_Store
.env
.venv/
venv/
__pycache__/
*.pyc
node_modules/
dist/
*.tsbuildinfo

# episode audio outputs (large, regenerable)
*/audio*/

# episode working directories — generated artifacts (research, script, rundown, audio).
# These derive from seasons.md and are local-only; curated samples live in examples/.
S[0-9][0-9]E[0-9][0-9]-*/

# files pulled off the pipeline LXC by scripts/fetch-script.sh, e.g.
# S01E03-weathervanes-script.md — same generated artifacts, flattened.
/S[0-9][0-9]E[0-9][0-9]-*.md
/S[0-9][0-9]E[0-9][0-9]-*.json

# live catalog — a local artifact, like .env. Seed it from seasons.example.md:
#   cp seasons.example.md seasons.md
/seasons.md
